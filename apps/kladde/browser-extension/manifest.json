{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_name__",
    "default_icon": { "32": "icons/32.png", "128": "icons/128.png" }
  },
  "icons": { "32": "icons/32.png", "128": "icons/128.png" },
  "commands": {
    "clip-article": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "__MSG_clipArticle__"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
